{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walkthroughstudio.dev/onboarding/packet/paths.schema.json",
  "title": "CriticalPaths (paths.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "headSHA": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidates": {
      "type": "integer",
      "minimum": 0
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "entry",
          "rank",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "title": {
            "type": "string"
          },
          "entry": {
            "type": "string",
            "pattern": "^(code|video|doc|diagram|trace|fact|commit|cmd|issue|url):.+$",
            "description": "An anchor string in the grammar of docs/onboarding/PACKET.md section 3. The reference validator parses and resolves it; this pattern only checks the prefix."
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "rationale": {
            "type": "string"
          },
          "businessImpact": {
            "type": [
              "string",
              "null"
            ]
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0
          },
          "traced": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0
    },
    "untraced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "headSHA",
    "paths"
  ]
}