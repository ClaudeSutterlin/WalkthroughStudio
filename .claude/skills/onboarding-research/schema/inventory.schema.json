{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walkthroughstudio.dev/onboarding/packet/inventory.schema.json",
  "title": "Inventory (inventory.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "headSHA": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "totalFiles": {
      "type": "integer",
      "minimum": 0
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "topLevel": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "files",
          "generated"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/].*/$|^\\.$",
            "description": "directory path with trailing slash, or '.' for root files"
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "languages": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "generated": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 0
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "file count by extension or language name"
    },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anchor",
          "kind"
        ],
        "properties": {
          "anchor": {
            "type": "string",
            "pattern": "^(code|video|doc|diagram|trace|fact|commit|cmd|issue|url):.+$",
            "description": "An anchor string in the grammar of docs/onboarding/PACKET.md section 3. The reference validator parses and resolves it; this pattern only checks the prefix."
          },
          "kind": {
            "type": "string",
            "enum": [
              "main",
              "httpRoute",
              "cli",
              "job",
              "worker",
              "test",
              "build",
              "ci",
              "infra",
              "other"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 0
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(code|video|doc|diagram|trace|fact|commit|cmd|issue|url):.+$",
        "description": "An anchor string in the grammar of docs/onboarding/PACKET.md section 3. The reference validator parses and resolves it; this pattern only checks the prefix."
      },
      "minItems": 0
    },
    "ci": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(code|video|doc|diagram|trace|fact|commit|cmd|issue|url):.+$",
        "description": "An anchor string in the grammar of docs/onboarding/PACKET.md section 3. The reference validator parses and resolves it; this pattern only checks the prefix."
      },
      "minItems": 0
    },
    "infra": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(code|video|doc|diagram|trace|fact|commit|cmd|issue|url):.+$",
        "description": "An anchor string in the grammar of docs/onboarding/PACKET.md section 3. The reference validator parses and resolves it; this pattern only checks the prefix."
      },
      "minItems": 0
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(code|video|doc|diagram|trace|fact|commit|cmd|issue|url):.+$",
        "description": "An anchor string in the grammar of docs/onboarding/PACKET.md section 3. The reference validator parses and resolves it; this pattern only checks the prefix."
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "headSHA",
    "totalFiles",
    "topLevel",
    "languages",
    "entryPoints",
    "manifests",
    "ci",
    "infra",
    "docs"
  ]
}