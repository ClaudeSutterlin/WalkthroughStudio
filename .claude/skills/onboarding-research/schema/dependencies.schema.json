{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walkthroughstudio.dev/onboarding/packet/dependencies.schema.json",
  "title": "Dependencies (dependencies.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "headSHA": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "manifest",
          "ecosystem",
          "license",
          "eol",
          "cves"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "manifest": {
            "type": "string",
            "pattern": "^(code|video|doc|diagram|trace|fact|commit|cmd|issue|url):.+$",
            "description": "An anchor string in the grammar of docs/onboarding/PACKET.md section 3. The reference validator parses and resolves it; this pattern only checks the prefix."
          },
          "ecosystem": {
            "type": "string",
            "enum": [
              "pypi",
              "npm",
              "swiftpm",
              "cargo",
              "go",
              "maven",
              "rubygems",
              "nuget",
              "composer",
              "system",
              "other"
            ]
          },
          "license": {
            "type": "string",
            "description": "SPDX id, or 'unknown'"
          },
          "eol": {
            "type": "string",
            "description": "'supported', 'end-of-life', 'unknown', or a date"
          },
          "cves": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "severity"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "critical",
                        "high",
                        "medium",
                        "low",
                        "unknown"
                      ]
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "minItems": 0
              },
              {
                "const": "unknown"
              }
            ]
          },
          "direct": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(code|video|doc|diagram|trace|fact|commit|cmd|issue|url):.+$",
              "description": "An anchor string in the grammar of docs/onboarding/PACKET.md section 3. The reference validator parses and resolves it; this pattern only checks the prefix."
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "headSHA",
    "dependencies"
  ]
}